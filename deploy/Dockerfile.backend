# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12.3-slim-bookworm@sha256:fd3817f3a855f6c2ada16ac9468e5ee93e361005bd226fd5a5ee1a504e038c84

FROM ${PYTHON_IMAGE} AS builder

ARG SOURCE_DATE_EPOCH
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN test -n "${SOURCE_DATE_EPOCH}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv

COPY requirements.lock /tmp/requirements.lock
COPY requirements-db-optional.lock /tmp/requirements-db-optional.lock
RUN /opt/venv/bin/python -m pip install \
    --no-compile \
    --no-deps \
    --require-hashes \
    --requirement /tmp/requirements.lock \
    --requirement /tmp/requirements-db-optional.lock

FROM ${PYTHON_IMAGE} AS runtime

ARG SOURCE_DATE_EPOCH
LABEL org.opencontainers.image.source-date-epoch="${SOURCE_DATE_EPOCH}"

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/app \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN test -n "${SOURCE_DATE_EPOCH}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libffi8 \
        libgl1 \
        libglib2.0-0 \
        libharfbuzz-subset0 \
        libjpeg62-turbo \
        libopenjp2-7 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libpq5 \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 . /app

RUN mkdir -p \
        /app/data \
        /app/logs \
        /home/app/.cache/huggingface \
        /var/lib/multiagent-memory/chromadb \
    && rm -rf /app/memory/chromadb /app/memory/smolagents_memory.db \
    && ln -s /var/lib/multiagent-memory/chromadb /app/memory/chromadb \
    && ln -s /var/lib/multiagent-memory/smolagents_memory.db \
        /app/memory/smolagents_memory.db \
    && chown -R 10001:10001 \
        /app/data \
        /app/logs \
        /home/app \
        /var/lib/multiagent-memory \
    && chmod 0555 /app/deploy/entrypoint-backend.sh

USER 10001:10001
ENTRYPOINT ["/app/deploy/entrypoint-backend.sh"]
CMD ["api"]
